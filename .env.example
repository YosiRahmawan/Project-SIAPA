APP_NAME=SIAPA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: Supabase (PostgreSQL). Isi dari Supabase > Project Settings > Database.
# Pakai role database khusus aplikasi (bukan postgres), koneksi wajib SSL.
# Untuk pengembangan tanpa Supabase, ganti ke: DB_CONNECTION=sqlite (dan hapus baris DB_* lainnya).
DB_CONNECTION=pgsql
DB_HOST=db.GANTI_DENGAN_PROJECT_REF.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=siapa_app
DB_PASSWORD=
DB_SSLMODE=require

# Supabase Storage untuk bukti QRIS (bucket privat). Hanya di server, jangan pernah di kode browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_BUKTI=bukti-pembayaran

# Sesi, cache, dan antrean tidak memakai database supaya tabelnya tidak ikut Supabase.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@siapa.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
